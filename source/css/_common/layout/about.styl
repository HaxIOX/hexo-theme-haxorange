/* 版心宽度由 base.css 的 .container 统一控制 */

.about-profile-card,
.about-panel {
  border: 1px solid var(--color-divider-md-border);
  border-radius: 8px;
  background: var(--bg-body);
}

.about-profile-card {
  padding: 24px 24px 0;
}

/* 头像和昵称交给页头（所有页面一致），卡片只放页头没有的信息，整体居中与页头同一中轴 */
.about-profile-main {
  text-align: center;
  h1 {
    margin: 0;
    color: var(--color-text-a);
    font-size: 2.5rem;
  }
}

.about-bio {
  margin: 10px 0 12px;
  color: var(--color-text-base);
  font-size: 1.5rem;
}

.about-meta {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 8px 16px;
  color: var(--color-text-sub);
  font-size: 1.3rem;
}

/* 统计并入资料卡底部，用卡片自身的描边，不再单独一个框 */
.about-stats {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  margin: 22px -24px 0;
  border-top: 1px solid var(--color-divider-md-border);
  div {
    padding: 14px 8px;
    text-align: center;
  }
  div + div {
    border-left: 1px solid var(--color-divider-md-border);
  }
  strong,
  span {
    display: block;
  }
  strong {
    color: var(--color-text-a);
    font-size: 2rem;
  }
  span {
    margin-top: 3px;
    color: var(--color-text-sub);
    font-size: 1.2rem;
  }
}

.about-panel {
  margin-top: 14px;
  padding: 20px;
  h2 {
    margin: 0 0 16px;
    color: var(--color-text-a);
    font-size: 1.8rem;
  }
}

.about-intro .markdown-body {
  font-size: 1.5rem;
}

.about-skill-groups {
  display: grid;
  gap: 18px;
}

.about-skill-group {
  h3 {
    margin: 0 0 9px;
    color: var(--color-text-sub);
    font-size: 1.3rem;
    font-weight: normal;
  }
}

.about-skill-list {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  span {
    padding: 5px 10px;
    border: 1px solid var(--color-divider-md-border);
    border-radius: 12px;
    color: var(--color-text-base);
    font-size: 1.3rem;
  }
}

.about-panel-heading {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  gap: 16px;
  h2 {
    margin-bottom: 16px;
  }
  span {
    color: var(--color-text-sub);
    font-size: 1.2rem;
  }
}

.about-activity-scroll {
  overflow-x: auto;
  padding-bottom: 6px;
}

.about-activity-grid {
  display: grid;
  grid-template-rows: repeat(7, 10px);
  grid-auto-flow: column;
  grid-auto-columns: 10px;
  gap: 3px;
  width: max-content;
  min-width: 100%;
}

.about-activity-cell,
.about-activity-legend i {
  display: block;
  border-radius: 2px;
  background: var(--activity-level-0);
}

/* 带上 .about-index 前缀：图例的 `.about-activity-legend i`（0,1,1）权重高于单类名（0,1,0），
   不加前缀时图例五格全被盖成 level-0 */
.about-index .about-activity-level-1 { background: var(--activity-level-1); }
.about-index .about-activity-level-2 { background: var(--activity-level-2); }
.about-index .about-activity-level-3 { background: var(--activity-level-3); }
.about-index .about-activity-level-4 { background: var(--activity-level-4); }
.about-activity-cell.is-outside-range { visibility: hidden; }

.about-activity-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 4px;
  margin-top: 10px;
  color: var(--color-text-sub);
  font-size: 1.1rem;
  i {
    width: 10px;
    height: 10px;
  }
}

.about-recent-posts {
  a {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 14px;
    padding: 9px 0;
    border-bottom: 1px solid var(--color-divider-md-border);
    font-size: 1.4rem;
  }
  a:last-child {
    border-bottom: 0;
  }
  time {
    color: var(--color-text-sub);
  }
  span {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
}

@media (max-width: 600px) {
  .about-profile-card {
    padding: 18px 18px 0;
  }
  .about-stats {
    margin: 18px -18px 0;
    grid-template-columns: repeat(2, 1fr);
    div:nth-child(3) {
      border-left: 0;
    }
    div:nth-child(n+3) {
      border-top: 1px solid var(--color-divider-md-border);
    }
  }
  .about-panel {
    padding: 16px;
  }
  .about-panel-heading {
    display: block;
  }
}
