.footer {
  padding-top: 30px;
  font-size: 1.2rem;
  color: #aaa;
  .social {
    padding-bottom: 5px;
    ul {
      text-align: center;
      li {
        display: inline-block;
        padding: 0 5px;
      }
    }
  }
  .footer-more {
    padding-bottom: 5px;
    text-align: center;
  }
  .footer-views {
    padding-bottom: 5px;
    text-align: center;
  }
  .footer-stats {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 4px;
    padding-bottom: 5px;
    text-align: center;
    .footer-stat-item {
      white-space: nowrap;
    }
    strong {
      color: var(--color-text-base);
      font-weight: 600;
    }
    .footer-stats-separator {
      padding: 0 6px;
    }
  }
}
