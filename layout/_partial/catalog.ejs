<% if (theme.catalog.enable && (toc(page.content) || toc(page.origin))) { %>
  <button id="btn-catalog" class="btn-catalog" type="button" aria-controls="catalog" aria-expanded="false" aria-label="<%= __('catalog') %>" title="<%= __('catalog') %>">
    <i class="iconfont icon-catalog" aria-hidden="true"></i>
  </button>
  <div class="post-catalog hidden" id="catalog">
    <div class="title"><%= __('catalog') %></div>
    <div class="catalog-content">
      <% if (page.encrypt == true) { %>
        <%- toc(page.origin, { "list_number": false }) %>
      <% } else { %>
        <%- toc(page.content, { "list_number": false }) %>
      <% } %>
    </div>
  </div>
  <div class="catalog-backdrop" id="catalog-backdrop" aria-hidden="true"></div>

  <%- js(['/js/catalog.js']) %>

<% } %>
