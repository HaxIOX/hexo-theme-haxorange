<%
  var about = theme.about || {};
  var profile = about.profile || {};
  var skills = Array.isArray(about.skills) ? about.skills : [];
  var allPosts = site.posts && site.posts.data ? site.posts.data.slice() : [];
  var allTags = site.tags && site.tags.data ? site.tags.data : [];
  var allCategories = site.categories && site.categories.data ? site.categories.data : [];
  var runtimeValue = theme.footer && theme.footer.stats && theme.footer.stats.runtime
    ? theme.footer.stats.runtime.since : null;
  var runtimeMatch = runtimeValue && String(runtimeValue).match(/\d{4}-\d{2}-\d{2}/);
  var runtimeSince = runtimeValue instanceof Date && !isNaN(runtimeValue.getTime())
    ? runtimeValue.toISOString().slice(0, 10)
    : (runtimeMatch ? runtimeMatch[0] : '');
  var runtimeTime = runtimeSince ? new Date(runtimeSince + 'T00:00:00').getTime() : NaN;
  var runtimeDays = Number.isFinite(runtimeTime)
    ? Math.max(0, Math.floor((Date.now() - runtimeTime) / 86400000)) : 0;

  var activity = about.activity || {};
  var activityDays = Math.min(730, Math.max(7, Number(activity.days) || 365));
  var today = new Date();
  today.setHours(0, 0, 0, 0);
  var activityStart = new Date(today);
  activityStart.setDate(today.getDate() - activityDays + 1);
  activityStart.setDate(activityStart.getDate() - activityStart.getDay());
  var activityEnd = new Date(today);
  activityEnd.setDate(today.getDate() + (6 - today.getDay()));
  var postCounts = {};
  allPosts.forEach(function(post) {
    if (!post.date || typeof post.date.format !== 'function') return;
    var key = post.date.format('YYYY-MM-DD');
    postCounts[key] = (postCounts[key] || 0) + 1;
  });
  function activityDateKey(date) {
    return date.getFullYear() + '-' + String(date.getMonth() + 1).padStart(2, '0') + '-' + String(date.getDate()).padStart(2, '0');
  }
  var activityStartKey = activityDateKey(activityStart);
  var todayKey = activityDateKey(today);
  var maxActivity = Object.keys(postCounts).filter(function(key) {
    return key >= activityStartKey && key <= todayKey;
  }).reduce(function(max, key) {
    return Math.max(max, postCounts[key]);
  }, 0);
  var activityCells = [];
  for (var cursor = new Date(activityStart); cursor <= activityEnd; cursor.setDate(cursor.getDate() + 1)) {
    var dateKey = activityDateKey(cursor);
    var count = postCounts[dateKey] || 0;
    var level = count === 0 ? 0 : Math.max(1, Math.ceil(count / Math.max(1, maxActivity) * 4));
    activityCells.push({ date: dateKey, count: count, level: level, future: cursor > today });
  }
  var yearPostCount = allPosts.filter(function(post) {
    return post.date && typeof post.date.year === 'function' && post.date.year() === today.getFullYear();
  }).length;
  var recentLimit = Math.min(20, Math.max(1, Number(about.recentPosts && about.recentPosts.limit) || 5));
  var recentPosts = allPosts.sort(function(a, b) { return b.date.valueOf() - a.date.valueOf(); }).slice(0, recentLimit);
%>

<div class="container about-index">
  <section class="about-profile-card">
    <img class="about-avatar" src="<%= url_for(profile.avatar || theme.avatar.author_photo) %>" alt="<%= profile.name || theme.avatar.author_nickname %>">
    <div class="about-profile-main">
      <h1><%= profile.name || theme.avatar.author_nickname %></h1>
      <% if (profile.bio) { %><p class="about-bio"><%= profile.bio %></p><% } %>
      <div class="about-meta">
        <% if (profile.location) { %><span>⌖ <%= profile.location %></span><% } %>
        <% (profile.links || []).forEach(function(link) { %>
          <a href="<%= url_for(link.url) %>" target="_blank" rel="noopener"><%= link.name %></a>
        <% }); %>
      </div>
    </div>
  </section>

  <section class="about-stats" aria-label="博客统计">
    <div><strong><%= allPosts.length %></strong><span>文章</span></div>
    <div><strong><%= allTags.length %></strong><span>标签</span></div>
    <div><strong><%= allCategories.length %></strong><span>分类</span></div>
    <div><strong><%= runtimeDays %></strong><span>运行天数</span></div>
  </section>

  <% if ((page.content || '').trim()) { %>
    <section class="about-panel about-intro">
      <h2>About me</h2>
      <div class="markdown-body"><%- page.content %></div>
    </section>
  <% } %>

  <% if (skills.length) { %>
    <section class="about-panel">
      <h2>Tech Stack</h2>
      <div class="about-skill-groups">
        <% skills.forEach(function(group) { %>
          <div class="about-skill-group">
            <h3><%= group.name %></h3>
            <div class="about-skill-list">
              <% (group.items || []).forEach(function(skill) { %><span><%= skill %></span><% }); %>
            </div>
          </div>
        <% }); %>
      </div>
    </section>
  <% } %>

  <% if (activity.enable !== false) { %>
    <section class="about-panel">
      <div class="about-panel-heading">
        <h2>Writing Activity</h2>
        <span><%= today.getFullYear() %> 年发布 <%= yearPostCount %> 篇</span>
      </div>
      <div class="about-activity-scroll">
        <div class="about-activity-grid" role="img" aria-label="最近 <%= activityDays %> 天文章发布热力图">
          <% activityCells.forEach(function(cell) { %>
            <span class="activity-cell level-<%= cell.level %><%= cell.future ? ' is-future' : '' %>" title="<%= cell.date %>：<%= cell.count %> 篇"></span>
          <% }); %>
        </div>
      </div>
      <div class="about-activity-legend"><span>少</span><i class="level-0"></i><i class="level-1"></i><i class="level-2"></i><i class="level-3"></i><i class="level-4"></i><span>多</span></div>
    </section>
  <% } %>

  <% if (!about.recentPosts || about.recentPosts.enable !== false) { %>
    <section class="about-panel">
      <h2>Recent Posts</h2>
      <div class="about-recent-posts">
        <% recentPosts.forEach(function(post) { %>
          <a href="<%= url_for(post.path) %>"><time><%= post.date.format('YYYY-MM-DD') %></time><span><%= post.title %></span></a>
        <% }); %>
      </div>
    </section>
  <% } %>
</div>
