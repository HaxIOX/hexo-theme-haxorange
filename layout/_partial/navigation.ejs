<%
  // rail: true 时只渲染导航菜单本身（用于文章页左导轨），不渲染页头的头像。
  var railNav = typeof rail !== 'undefined' && rail;
%>
<% if (!railNav) { %>
<div class="header">
  <div class="avatar">
    <a href="<%- theme.avatar.path %>">
      <!-- 头像取消懒加载，添加no-lazy -->
      <% if (config.lazyload && config.lazyload.enable) { %>
        <img no-lazy src="<%- theme.avatar.author_photo %>" alt="">
      <% } else { %>
        <img src="<%- theme.avatar.author_photo %>" alt="">
      <% } %>
    </a>
    <div class="nickname"><a href="<%- theme.avatar.path %>"><%- theme.avatar.author_nickname %></a></div>
  </div>
<% } %>
  <div class="navbar<%= railNav ? ' navbar--rail' : '' %>">
    <% if (railNav) { %>
    <!-- 灯绳导航的悬浮命中区：灯绳本体只有 2px 宽，瞄准很难，
         这块透明矩形把「灯绳附近」也算进可悬浮范围（样式见 catalog-left.css） -->
    <span class="rail-hit" aria-hidden="true"></span>
    <% } %>
    <ul>
      <%
        for(let item of theme.navbar) {
          if (item.enable) {
      %>
        <li class="nav-item" data-path="<%- item.path %>">
          <a href="<%- item.path %>"><%- item.name %></a>
        </li>
      <%
          }
        }
      %>
    </ul>
  </div>
<% if (!railNav) { %>
</div>
<% } %>

<%- js(['/js/activeNav.js']) %>

<% if (railNav) { %>
  <%- js(['/js/topNav.js']) %>
<% } %>
