<!-- 归档页，展示本站所有文章，按照年份降序归类，url形式：https://yoursite/archives/ -->
<!-- 以竖线时间轴呈现：年份节点 + 每篇文章一个节点 -->

<div class="container archives">
  <div class="timeline">
    <%
      // 预遍历统计各年份文章数，用于年份节点角标
      var postsByDate = site.posts.sort('date', -1);
      var yearCount = {};
      postsByDate.each(function(item) {
        var y = item.date.year();
        yearCount[y] = (yearCount[y] || 0) + 1;
      });

      var prev = -10086;// prev year
      var curr;// curr year, ever step be updated

      postsByDate.each(function(item) {
        curr = item.date.year();
        if (curr !== prev) {
          prev = curr;
      %>
        <!-- 后续文章的发布年份节点 -->
        <div class="timeline-year">
          <span class="timeline-year-dot"></span>
          <span class="timeline-year-title"><%- curr %></span>
          <% if (yearCount[curr]) { %>
            <span class="timeline-year-count"><%- yearCount[curr] %></span>
          <% } %>
        </div>
      <%
        }
      %>
      <div class="timeline-item" title="<%- item.title %>">
        <span class="timeline-dot"></span>
        <div class="timeline-meta">
          <span class="timeline-date"><%- item.date.format("MM-DD") %></span>
          <a class="timeline-link" href="<%- url_for(item.path) %>">
            <%- item.title %>
          </a>
        </div>
      </div>
    <%
      });
    %>
  </div>
</div>
